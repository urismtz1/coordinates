{
  "manifest_version": 3,
  "name": "Coordenadas GPS con clic derecho",
  "version": "2.3",
  "description": "Copiado de coordenadas Command y Traffilog, con bloqueador de banner de licencia y pegado con tecla o rueda del mouse",
  "permissions": [
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Configuración de pegado",
    "default_popup": "opciones.html"
  },
  "options_ui": {
    "page": "opciones.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.omnitracs.com/*",
        "https://mx.traffilog.com/*",
        "https://www.google.com/maps*",
        "https://www.google.com.mx/maps*"
      ],
      "js": ["content.js"],
      "css": ["ocultar-aviso-bing.css"],
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["configuracion.js", "pegar.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ]
}
