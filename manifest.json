{
  "manifest_version": 3,
  "name": "Coordenadas GPS con clic derecho",
  "version": "1.1",
  "description": "Copia las coordenadas de mapas de Google.(TRaffilog) ",
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
